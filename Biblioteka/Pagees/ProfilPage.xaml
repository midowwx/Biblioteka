<Page x:Class="Biblioteka.ProfilPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Biblioteka"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ProfilPage">

    <Grid Margin="20">
        <StackPanel>
        <TextBlock Text="Профиль пользователя" FontSize="24" FontWeight="Bold" Margin="0,0,0,30"/>
            </StackPanel>

            <!-- StackPanel выстраивает элементы строго друг под другом -->
        <StackPanel Margin="0,47,0,0">

            <!-- Имя -->
            <TextBlock Text="Имя:" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBlock Text="{Binding FirstName}" Margin="0,0,0,15"/>

            <!-- Фамилия -->
            <TextBlock Text="Фамилия:" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBlock Text="{Binding LastName}" Margin="0,0,0,15"/>

            <!-- Дата регистрации -->
            <TextBlock Text="Дата регистрации:" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBlock Text="{Binding RegistrationDate, StringFormat=d}" Margin="0,0,0,25"/>

            <!-- Разделительная линия -->
            <Border BorderThickness="0,1,0,0" BorderBrush="LightGray" Margin="0,0,0,25"/>

            <!-- Телефон -->
            <TextBlock Text="Телефон:" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,15"/>

            <!-- Email -->
            <TextBlock Text="Email:" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,30"/>

        </StackPanel>

        <!-- Кнопка. Поскольку StackPanel занял всё вертикальное пространство, 
             кнопку удобнее разместить в отдельном Grid внизу -->
        <Grid HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="0,0,0,20">
            <Button Content="Сохранить" Width="100" Click="SaveButton_Click" Background="#FF3BD1B6" Foreground="White"/>
        </Grid>
    </Grid>
</Page>
