<Page x:Class="Biblioteka.ProfilPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Biblioteka"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ProfilPage">

    <Grid Margin="20">
        <StackPanel>
        <TextBlock Text="Профиль пользователя" FontSize="24" FontWeight="Bold" Margin="0,0,0,30"/>
            </StackPanel>

        <StackPanel Margin="0,47,0,0">

            <TextBlock Text="Имя:" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBlock Text="{Binding Name}" Margin="0,0,0,15"/>

            <TextBlock Text="Фамилия:" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBlock Text="{Binding LastName}" Margin="0,0,0,15"/>

            <TextBlock Text="Дата регистрации:" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBlock Text="{Binding DataRegistration, StringFormat=d}" Margin="0,0,0,25"/>

            <Border BorderThickness="0,1,0,0" BorderBrush="LightGray" Margin="0,0,0,25"/>

            <TextBlock Text="Телефон:" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBox Name="ph1" Text="{Binding NumberPhone, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,15"/>
            <TextBlock Name="ph2" Text="{Binding NumberPhone}" Margin="0,0,0,15" Visibility="Hidden"/>

            <TextBlock Text="Email:" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBox Name="em1" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,30"/>
            <TextBlock Name="em2" Text="{Binding Email}" Margin="0,0,0,15" Visibility="Hidden"/>
        </StackPanel>

        <Grid HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="0,0,0,20">
            <Button Name="save" Content="Сохранить" Width="100" Click="Button_Click"  Background="#FF3BD1B6" Foreground="White"/>
        </Grid>
    </Grid>
</Page>
