<Window x:Class="Biblioteka.BibliotekaGlav"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Biblioteka"
        mc:Ignorable="d"
        Title="Библиотека" ResizeMode="NoResize" WindowState="Maximized" Height="337" Width="622">
    <Grid>
        <DockPanel LastChildFill="True" >
            <StackPanel DockPanel.Dock="Top" Background="#FF3BD1B6" Orientation="Horizontal">
                <Label Content="Библиотека" FontSize="24" Foreground="White" Margin="10"/>
            </StackPanel>

            <Menu DockPanel.Dock="Top" VerticalAlignment="Center" Padding="10">
                <MenuItem Header="_Книги" Tag="BooksPage" Click="MenuItem_Clikc"/>
                <MenuItem Header="Выдачи" Tag="LoansPage" Click="MenuItem_Clikc"/>
                <MenuItem Header="Профиль" Tag="ProfilPage" Click="MenuItem_Clikc"></MenuItem>
            </Menu>
            <Frame Name="AppFrame" NavigationUIVisibility="Hidden" Margin="10 0 10 10"/>
        </DockPanel>
    </Grid>
</Window>
