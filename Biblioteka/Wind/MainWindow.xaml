<Window x:Class="Biblioteka.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Biblioteka"
        mc:Ignorable="d"
        Title="Авторизация" Height="450" Width="350" ResizeMode="NoResize">
    <Grid VerticalAlignment="Center">
        <StackPanel Margin="10" HorizontalAlignment="Center">
            <Label Content="Вход" FontSize="24" Foreground="#FF3BD1B6" HorizontalContentAlignment="Center"/>
            <Label Content="Логин" FontSize="14" Foreground="Black"/>
            <TextBox Name="LoginTextBox" Text="" Margin="0 0 0 10" Width="250"/>
            <Label Content="Пароль" FontSize="14" Foreground="Black"/>
            <PasswordBox Name="PaswordTextBox" Margin="0 0 0 10" Width="250"/>
            <Button Content="Вход" Background="#FF3BD1B6" Foreground="White" Margin=" 0 0 0 5" BorderThickness="0" Cursor="Hand" Height="31" Click="BtnLogin_Click"/>
            <Button Content="Регистрация" Background="#FF3BD1B6" Foreground="White" Padding="10 8" BorderThickness="0" Cursor="Hand" Click="BtnRegister_Click"/>
        </StackPanel>
    </Grid>
</Window>
