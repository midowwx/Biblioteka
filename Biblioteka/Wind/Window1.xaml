<Window x:Class="Biblioteka.Window1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Biblioteka"
        mc:Ignorable="d"
       Title="Регистрация" Height="450" Width="350" ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <Grid VerticalAlignment="Center" Height="446">
        <StackPanel Margin="0,36,0,66" HorizontalAlignment="Center">
            <Label Content="Регистрация" FontSize="24" Foreground="#FF3BD1B6" HorizontalContentAlignment="Center"/>

            <TextBlock Text="Имя" FontSize="14" Margin="0 5 0 0"/>
            <TextBox Name="NameTextBox" Width="250" Margin="0,0,0,10"/>

            <TextBlock Text="Фамилия" FontSize="14" Margin="0,10,0,0"/>
            <TextBox Name="LastNameTextBox" Width="250" Margin="0,0,0,10"/>

            <TextBlock Text="Логин" FontSize="14" Margin="0,10,0,0"/>
            <TextBox Name="LoginTextBox" Width="250" Margin="0,0,0,10"/>

            <TextBlock Text="Пароль" FontSize="14" Margin="0,10,0,0"/>
            <PasswordBox Name="PaswordTextBox" Width="250" Margin="0,0,0,20"/>

            <Button Content="Зарегистрироваться" Background="#FF3BD1B6" Foreground="White" Padding="10 7" BorderThickness="0" Cursor="Hand" Click="BtnZaRegister_Click"/>
        </StackPanel>
    </Grid>
</Window>
